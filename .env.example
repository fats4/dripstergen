# --- Same-origin (default): leave all empty, serve from public/traits/ ---

# --- Option A: CDN / S3 / R2 / full IPFS gateway URL (no trailing slash) ---
# VITE_ASSETS_BASE_URL=https://assets.yourdomain.com
# VITE_ASSETS_BASE_URL=https://gateway.pinata.cloud/ipfs/QmYourFolderCid

# --- Option B: IPFS folder CID + gateway (app builds URLs) ---
# Pin ipfs-upload/ (must contain traits/ subfolder). Use that folder's CID.
# VITE_IPFS_CID=QmYourFolderCid
# VITE_IPFS_GATEWAY=https://dweb.link

# --- GitHub Pages deploy (Settings → Secrets → Actions) ---
# VITE_IPFS_CID       = same CID as above
# VITE_IPFS_GATEWAY   = https://dweb.link
# Enable Pages: Settings → Pages → Source: GitHub Actions
# Live URL: https://<username>.github.io/dripstergen/
