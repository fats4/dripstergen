# --- Same-origin (default): leave all empty, serve from public/traits/ ---

# --- Cloudflare R2 (recommended for 3000+ files) ---
# Production URL (prefer custom domain — *.r2.dev may be blocked by some ISPs)
# VITE_ASSETS_BASE_URL=https://assets.mondrips.com
# VITE_ASSETS_BASE_URL=https://pub-xxxxxxxx.r2.dev
#
# Local dev when r2.dev blocked: leave VITE_ASSETS_BASE_URL empty + set R2_DEV_PROXY=true
# R2_DEV_PROXY=true
#
# Upload credentials (local only — for npm run upload:r2, do NOT commit):
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=dripstergen-assets
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
#
# GitHub Secret: VITE_ASSETS_BASE_URL = same public URL

# --- Option A: other CDN / full gateway URL (no trailing slash) ---
# VITE_ASSETS_BASE_URL=https://assets.yourdomain.com

# --- Option B: IPFS folder CID + gateway ---
# VITE_IPFS_CID=QmYourFolderCid
# VITE_IPFS_GATEWAY=https://dweb.link

# --- GitHub Pages ---
# Secrets: VITE_ASSETS_BASE_URL (R2) OR VITE_IPFS_CID + VITE_IPFS_GATEWAY
# Variable: GH_PAGES_BASE = /  (custom domain driplab.mondrips.com)
