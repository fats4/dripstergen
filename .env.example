# --- Trait assets ---
# Production / build: set public CDN URL
# VITE_ASSETS_BASE_URL=https://assets.mondrips.com
#
# Local dev with R2 credentials in .env (default): traits load from R2 via /traits/* proxy.
# Opt out (use public/traits/): VITE_R2_DEV_TRAITS=false
# VITE_R2_DEV_TRAITS=true
#
# Upload credentials (local only — for npm run upload:r2, do NOT commit):
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=dripstergen-assets
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
#
# GitHub Secret (github-pages environment): VITE_ASSETS_BASE_URL = same public URL
#
# MONIGGA collab (off in prod unless set at build time; on in local dev):
# VITE_ENABLE_MONIGGA_COLLAB=true

# --- GitHub Pages ---
# Variable: GH_PAGES_BASE = /  (custom domain driplab.mondrips.com)
