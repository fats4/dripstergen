{
  "name": "dripstergen",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "optimize-traits": "node scripts/optimize-traits.mjs",
    "optimize-traits:replace": "node scripts/optimize-traits.mjs --replace",
    "generate-r2-thumbs": "node scripts/generate-r2-thumbs.mjs",
    "build:assets-manifest": "node scripts/build-assets-manifest.mjs",
    "prepare:r2": "node scripts/prepare-r2-upload.mjs",
    "prepare:r2:update": "node scripts/prepare-r2-upload.mjs --from=update",
    "restore:update": "node scripts/restore-update-from-dist.mjs",
    "sanitize:traits": "node scripts/sanitize-trait-filenames.mjs --root=update/traits",
    "optimize:update": "node scripts/optimize-traits.mjs --root=update/traits --replace",
    "upload:r2": "node scripts/upload-r2.mjs",
    "upload:r2:full": "node scripts/upload-r2.mjs --with-scan",
    "upload:update": "node scripts/prepare-r2-upload.mjs --from=update && node scripts/upload-r2.mjs --rebuild-scan && node scripts/verify-catalog.mjs",
    "replace:r2": "node scripts/replace-r2-asset.mjs",
    "rebuild:scan": "node scripts/rebuild-scan-from-r2.mjs",
    "rebuild:scan:upload": "node scripts/rebuild-scan-from-r2.mjs --upload",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "apply:r2-cors": "node scripts/apply-r2-cors.mjs",
    "apply:update": "node scripts/apply-update.mjs",
    "remove:update": "node scripts/remove-applied-update.mjs",
    "build:pages": "GH_PAGES=true vite build"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.826.0",
    "sharp": "^0.34.1",
    "vite": "^6.3.5"
  }
}
